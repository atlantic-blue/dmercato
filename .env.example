# AWS
AWS_REGION=us-east-1
AWS_PROFILE=dmercato

# DynamoDB table names
TENANTS_TABLE=dmercato-tenants-staging
QUOTE_REQUESTS_TABLE=dmercato-quote-requests-staging
ORDERS_TABLE=dmercato-orders-staging
SESSIONS_TABLE=dmercato-sessions-staging
MAGIC_LINKS_TABLE=dmercato-magic-links-staging

# S3 buckets
ASSETS_BUCKET=dmercato-assets-staging
ADMIN_BUCKET=dmercato-admin-staging
SITEMAPS_BUCKET=dmercato-sitemaps-staging

# CloudFront
CLOUDFRONT_DISTRIBUTION_ID=

# SES
SES_FROM_ADDRESS=noreply@dmercato.com

# App
BASE_URL=https://staging.dmercato.com
